# CHR wallet — bs-p native engine (spread + OBI focus)
# Conservative params for $304 USDC bankroll.
# See docs/bs-p/deployment-guide.md for tuning schedule.

BOT_WALLET_ID=CHR

# =============================================================================
# MODE
# =============================================================================
PAPER_TRADING=false
PAPER_BALANCE_USD=304

# =============================================================================
# bs-p NATIVE ENGINE
# =============================================================================
NATIVE_ENGINE_ENABLED=true
QUOTING_GAMMA=1.0
QUOTING_K=2.0
QUOTING_TAU_DEFAULT=0.05
GREEKS_DELTA_ALERT=0.3
GREEKS_GAMMA_ALERT=0.2

# =============================================================================
# RISK / SIZING (adaptive — scales with bankroll)
# =============================================================================
ADAPTIVE_RISK_ENABLED=true
ADAPTIVE_MAX_POSITION_PCT=0.12
ADAPTIVE_MAX_EXPOSURE_PCT=0.30
ADAPTIVE_MAX_SINGLE_TRADE_PCT=0.03
ADAPTIVE_DAILY_LOSS_LIMIT_PCT=0.06
ADAPTIVE_DRAWDOWN_THROTTLE_PCT=0.05
ADAPTIVE_DRAWDOWN_HALT_PCT=0.12
ADAPTIVE_MIN_BALANCE_FLOOR_PCT=0.70

ORDER_SIZE_USD=5
MAX_POSITION_USD=36
MAX_TOTAL_EXPOSURE_USD=91
DAILY_LOSS_LIMIT_USD=18
MIN_BALANCE_USD=212
MAX_ACTIVE_ORDERS=20
ORDER_TIMEOUT_SECONDS=300

# Kelly — conservative for small bankroll
KELLY_FRACTION_MODE=quarter
KELLY_MAX_BET_FRACTION=0.03
KELLY_MIN_EDGE=0.015

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
SCAN_INTERVAL_SECONDS=5
MARKET_REFRESH_SECONDS=120
BALANCE_REFRESH_SECONDS=30
ENABLE_WEBSOCKET_FEED=true
LOG_LEVEL=INFO
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5
AUTO_ALLOWANCE_REFRESH_ENABLED=true
ALLOWANCE_REFRESH_SECONDS=900
ALLOWANCE_DIAGNOSTICS_ENABLED=false
CLOB_HEARTBEAT_ENABLED=true
CLOB_HEARTBEAT_INTERVAL_SECONDS=8
TRADE_FETCH_TIMEOUT_SECONDS=7
BALANCE_FETCH_TIMEOUT_SECONDS=7
BALANCE_STALE_BLOCK_BUYS=true
BALANCE_STALE_MAX_SECONDS=240
ENABLE_STRATEGY_ANALYTICS=true

# =============================================================================
# STRATEGIES — spread + orderbook imbalance only
# =============================================================================
DISABLED_STRATEGIES=arbitrage,favorite_longshot,cross_platform_arbitrage,cross_asset,stink_bid,late_money,vpin,sentiment,terminal_convergence,wallet_copy,combinatorial_arb
ENABLE_BTC_5MIN=true

# =============================================================================
# MARKET FILTERS
# =============================================================================
ONLY_CRYPTO_MARKETS=true
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95
MIN_VOLUME_USD=500
MIN_SPREAD_CENTS=1

# =============================================================================
# SPREAD STRATEGY (bs-p Avellaneda-Stoikov)
# =============================================================================
TRADING_FEE_RATE=0.002
MIN_PROFIT_MARGIN=0.001

# =============================================================================
# VOLATILITY REGIME
# =============================================================================
VOL_WINDOW_SECONDS=300
VOL_HIGH_THRESHOLD=0.80
VOL_LOW_THRESHOLD=0.30
VOL_HIGH_SPREAD_MULT=1.5
VOL_LOW_SPREAD_MULT=0.7

# =============================================================================
# TELEGRAM (fill in from .env)
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
