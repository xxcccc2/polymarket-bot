# Shared NON-SECRET bot settings for wallet_copy + terminal_convergence + combinatorial_arb.
# Keep keys/wallet addresses in .env only.
#
# Start each bot with (wallet_copy only, one instance per wallet):
#   BOT_PUBLIC_CONFIG_FILE=./config/settings.walletcopy.multiwallet.example BOT_WALLET_ID=CHR ./venv/bin/python -m src.bot --strategy wallet_copy
#   BOT_PUBLIC_CONFIG_FILE=./config/settings.walletcopy.multiwallet.example BOT_WALLET_ID=BB  ./venv/bin/python -m src.bot --strategy wallet_copy
#
# Or run all three strategies (wallet_copy + terminal + combo):
#   Add ENABLE_BTC_5MIN=true (terminal_convergence loads with btc_5min group)
#   BOT_PUBLIC_CONFIG_FILE=... BOT_WALLET_ID=CHR ./venv/bin/python -m src.bot --strategy all
#
# In .env, per wallet:
#   POLYMARKET_PRIVATE_KEY_<ID>=...
#   POLYMARKET_PROXY_ADDRESS_<ID>=0x...
#   SIGNATURE_TYPE_<ID>=...

BOT_WALLET_ID=

# =============================================================================
# MODE
# =============================================================================
PAPER_TRADING=false
PAPER_BALANCE_USD=1000

# =============================================================================
# RISK / SIZING (adaptive on, but avoid tiny fee-inefficient orders)
# =============================================================================
# Adaptive risk is PER BOT INSTANCE — each wallet (chr, bb) has its own limits
# based on its own balance. They do NOT share or aggregate.
#
# Example with current config (ADAPTIVE_MAX_SINGLE_TRADE_PCT=0.08, etc.):
#
#   chr ($179):  max_trade=$14.32  max_position=$21.48  max_exposure=$53.70
#                daily_loss_limit=$10.74  balance_floor=$125.30
#
#   bb  ($80):  max_trade=$6.40   max_position=$9.60   max_exposure=$24.00
#               daily_loss_limit=$4.80   balance_floor=$56.00
#
# Both use WALLET_COPY_SIZE_USD ($6) per copy; adaptive caps to min(size, max_trade).
# bb may get resized: $6 > $6.40 max_trade → uses $6 (still under cap).
# Drawdown: at 10% DD → throttle to ~50%; at 18% DD → halt.
#
ADAPTIVE_RISK_ENABLED=true
ADAPTIVE_MAX_POSITION_PCT=0.12
ADAPTIVE_MAX_EXPOSURE_PCT=0.30
ADAPTIVE_MAX_SINGLE_TRADE_PCT=0.08
ADAPTIVE_DAILY_LOSS_LIMIT_PCT=0.06
ADAPTIVE_DRAWDOWN_THROTTLE_PCT=0.10
ADAPTIVE_DRAWDOWN_HALT_PCT=0.18
ADAPTIVE_MIN_BALANCE_FLOOR_PCT=0.70

# Keep base sizing large enough to not be fee-dominated.
# Wallet_copy gets WALLET_COPY_SIZE_USD (below); terminal/conbo use ORDER_SIZE_USD.
# For wallet_copy as MAIN: set WALLET_COPY_SIZE_USD higher, ORDER_SIZE_USD lower.
ORDER_SIZE_USD=4
MAX_POSITION_USD=15
MAX_TOTAL_EXPOSURE_USD=9999999
DAILY_LOSS_LIMIT_USD=9999999
MIN_BALANCE_USD=4
MAX_ACTIVE_ORDERS=999
ORDER_TIMEOUT_SECONDS=300

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
SCAN_INTERVAL_SECONDS=2
MARKET_REFRESH_SECONDS=300
BALANCE_REFRESH_SECONDS=60
ENABLE_WEBSOCKET_FEED=false
LOG_LEVEL=INFO
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5
AUTO_ALLOWANCE_REFRESH_ENABLED=true
ALLOWANCE_REFRESH_SECONDS=900
ALLOWANCE_DIAGNOSTICS_ENABLED=false
CLOB_HEARTBEAT_ENABLED=true
CLOB_HEARTBEAT_INTERVAL_SECONDS=8
TRADE_FETCH_TIMEOUT_SECONDS=7
BALANCE_FETCH_TIMEOUT_SECONDS=7
BALANCE_STALE_BLOCK_BUYS=true
BALANCE_STALE_MAX_SECONDS=240
ENABLE_STRATEGY_ANALYTICS=false

# =============================================================================
# STRATEGIES
# =============================================================================
DISABLED_STRATEGIES=spread,arbitrage,favorite_longshot,cross_platform_arbitrage,cross_asset,orderbook_imbalance,stink_bid,late_money,vpin,sentiment
ENABLE_BTC_5MIN=false

# =============================================================================
# MARKET FILTERS
# =============================================================================
ONLY_CRYPTO_MARKETS=false
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95
MIN_VOLUME_USD=10000

# =============================================================================
# TERMINAL CONVERGENCE (near-expiry)
# =============================================================================
TERMINAL_CONVERGENCE_WINDOW_SECONDS=60
TERMINAL_MIN_EDGE_CENTS=3

# =============================================================================
# COMBINATORIAL ARB
# =============================================================================
COMBO_MIN_EDGE_CENTS=3
COMBO_COOLDOWN=300

# =============================================================================
# WALLET COPY
# =============================================================================
# TRACKED_WALLETS format:
# - comma-separated proxy addresses
# - no quotes required
# - spaces are allowed (they are trimmed)
# Example:
# TRACKED_WALLETS=0xabc...,0xdef...,0x123...
TRACKED_WALLETS=
WALLET_COPY_USE_LEADERBOARD=true
WALLET_COPY_LEADERBOARD_TOP_N=4
WALLET_COPY_LEADERBOARD_CATEGORY=CRYPTO
WALLET_COPY_LEADERBOARD_PERIOD=MONTH

# Keep copy size >= ~$4-5 to reduce fee drag.
# Higher than ORDER_SIZE_USD so wallet_copy gets most size (main strategy).
WALLET_COPY_SIZE_USD=6
WALLET_COPY_SIZE_MULTIPLIER=1.0
WALLET_COPY_MAX_DELAY_SECONDS=80
WALLET_COPY_MIN_TRADE_USD=10
WALLET_COPY_CRYPTO_ONLY=true
WALLET_COPY_COOLDOWN_SECONDS=60
WALLET_COPY_MIN_WALLET_POLL_SECONDS=2.0
