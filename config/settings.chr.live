# CHR wallet — terminal + combinatorial_arb + wallet_copy ($130 bankroll)

BOT_WALLET_ID=CHR

# =============================================================================
# MODE
# =============================================================================
PAPER_TRADING=false
PAPER_BALANCE_USD=125

# =============================================================================
# bs-p NATIVE ENGINE
# =============================================================================
NATIVE_ENGINE_ENABLED=false
QUOTING_GAMMA=1.0
QUOTING_K=2.0
QUOTING_TAU_DEFAULT=0.05
GREEKS_DELTA_ALERT=0.3
GREEKS_GAMMA_ALERT=0.2

# =============================================================================
# RISK / SIZING — $130 bankroll
# Fixed: ADAPTIVE_RISK_ENABLED=false, use ORDER_SIZE/MAX_* below
# Adaptive: ADAPTIVE_RISK_ENABLED=true — limits scale with balance
#   At $130: max_pos 12%=$15.6, exposure 30%=$39, single_trade 4%=$5.2 (Polymarket min 5 shares)
# =============================================================================
ADAPTIVE_RISK_ENABLED=false
ADAPTIVE_MAX_POSITION_PCT=0.12
ADAPTIVE_MAX_EXPOSURE_PCT=0.35
ADAPTIVE_MAX_SINGLE_TRADE_PCT=0.04
ADAPTIVE_DAILY_LOSS_LIMIT_PCT=0.1
ADAPTIVE_DRAWDOWN_THROTTLE_PCT=0.25
ADAPTIVE_DRAWDOWN_HALT_PCT=0.35
ADAPTIVE_MIN_BALANCE_FLOOR_PCT=0.5

# Base sizes (Polymarket min 5 shares; $5 ensures 5+ shares at any price --must confirm this info*)
ORDER_SIZE_USD=5
MAX_POSITION_USD=10
MAX_TOTAL_EXPOSURE_USD=75
DAILY_LOSS_LIMIT_USD=999
MIN_BALANCE_USD=5
MAX_ACTIVE_ORDERS=32
ORDER_TIMEOUT_SECONDS=999999

# Kelly — quarter Kelly, max 3% of bankroll ($3.90 at $130)
KELLY_FRACTION_MODE=quarter
KELLY_MAX_BET_FRACTION=0.03
KELLY_MIN_EDGE=0.015

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
SCAN_INTERVAL_SECONDS=2
MARKET_REFRESH_SECONDS=60
BALANCE_REFRESH_SECONDS=10
ENABLE_WEBSOCKET_FEED=true
LOG_LEVEL=INFO
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5
AUTO_ALLOWANCE_REFRESH_ENABLED=true
ALLOWANCE_REFRESH_SECONDS=900
ALLOWANCE_DIAGNOSTICS_ENABLED=false
CLOB_HEARTBEAT_ENABLED=true
CLOB_HEARTBEAT_INTERVAL_SECONDS=8
TRADE_FETCH_TIMEOUT_SECONDS=7
BALANCE_FETCH_TIMEOUT_SECONDS=7
BALANCE_STALE_BLOCK_BUYS=true
BALANCE_STALE_MAX_SECONDS=240
ENABLE_STRATEGY_ANALYTICS=true

# =============================================================================
# STRATEGIES
# =============================================================================
DISABLED_STRATEGIES=arbitrage,favorite_longshot,cross_platform_arbitrage,cross_asset,stink_bid,late_money,vpin,sentiment,spread,orderbook_imbalance
ENABLE_BTC_5MIN=true

# =============================================================================
# MARKET FILTERS
# =============================================================================
# false = fetch all markets (crypto + political/sports) so spread can trade non-crypto
ONLY_CRYPTO_MARKETS=false
# Spread: false = trade all markets in universe (crypto + non-crypto)
SPREAD_ONLY_CRYPTO_MARKETS=true
# true = only 5m/15m/1h/4h up/down (excludes MegaETH); false = all crypto
SPREAD_ONLY_SHORTTERM_CRYPTO=true
MIN_PRICE_CENTS=2
MAX_PRICE_CENTS=99.1
MIN_VOLUME_USD=500
MIN_SPREAD_CENTS=1
MAX_HOURS_TO_EXPIRY=5
SHORTTERM_MAX_HOURS_AHEAD=5

# =============================================================================
# SPREAD STRATEGY (bs-p Avellaneda-Stoikov)
# =============================================================================
TRADING_FEE_RATE=0.002
SPREAD_LOG_VERBOSE=false
MAKER_FEE_RATE=0
MIN_PROFIT_MARGIN=0.005

# =============================================================================
# VOLATILITY REGIME 
# =============================================================================
VOL_WINDOW_SECONDS=300
VOL_HIGH_THRESHOLD=0.80
VOL_LOW_THRESHOLD=0.30
VOL_HIGH_SPREAD_MULT=1.5
VOL_LOW_SPREAD_MULT=0.7

# =============================================================================
# TERMINAL CONVERGENCE (1h Up/Down only — Binance = resolution source)
# =============================================================================
# 1h-only: only trade 1h markets (5m/15m/4h use Chainlink, not Binance)
TERMINAL_CONVERGENCE_1H_ONLY=true
# Seconds before expiry. 120s for 1h; 60s for 5m/15m
TERMINAL_CONVERGENCE_WINDOW_SECONDS=120
TERMINAL_MIN_EDGE_CENTS=1

# =============================================================================
# ML DIRECTIONAL EDGE
# Keep these knobs in the shared profile file so the strategy can be promoted
# from paper to live without editing `.env`. Start disabled until an artifact
# has been trained and validated.
# =============================================================================
ML_DIRECTIONAL_ENABLED=false
ML_DIRECTIONAL_MODEL_PATH=./data/ml/artifacts/ml_directional_latest.pkl
ML_DIRECTIONAL_ENABLED_HORIZONS=15m,1h
ML_DIRECTIONAL_MIN_PROBABILITY=0.53
ML_DIRECTIONAL_MIN_EDGE=0.03
ML_DIRECTIONAL_MAKER_OFFSET=0.005
ML_DIRECTIONAL_SIGNAL_COOLDOWN_SECONDS=45
ML_DIRECTIONAL_ROLLING_ACCURACY_WINDOW=100
ML_DIRECTIONAL_MIN_ROLLING_ACCURACY=0.51
ML_DIRECTIONAL_BRIER_WINDOW=50
ML_DIRECTIONAL_MAX_ROLLING_BRIER=0.26
ML_BINANCE_COLLECTOR_DB=./data/ml/collectors/binance_microstructure.sqlite

# =============================================================================
# COMBINATORIAL ARB
# =============================================================================
COMBO_MIN_EDGE_CENTS=3
COMBO_COOLDOWN=300

# =============================================================================
# WALLET COPY
# =============================================================================
# 0x1979ae6b7e6534de9c4539d0c205e582ca637c9d,0x1d0034134e339a309700ff2d34e99fa2d48b0313,0x1461cc6e1a05e20710c416307db62c28f1d122d8
# 0x8E9cD5eC7a26d602b63B4bC4C193fEbB83c8eD64,0x70ec235a31eb35f243e2618d6ea3b5b8962bbb5d
TRACKED_WALLETS=0x4c353dd347c2e7d8bcdc5cd6ee569de7baf23e2f,0x1d0034134e339a309700ff2d34e99fa2d48b0313,0x6bab41a0dc40d6dd4c1a915b8c01969479fd1292,0x751a2b86cab503496efd325c8344e10159349ea1,0x9e8283a004204504e52c67f4f387dfb03ba4a28b,0xd84c2b6d65dc596f49c7b6aadd6d74ca91e407b9,0x000d257d2dc7616feaef4ae0f14600fdf50a758e
WALLET_COPY_USE_LEADERBOARD=false
WALLET_COPY_LEADERBOARD_TOP_N=1
WALLET_COPY_LEADERBOARD_CATEGORY=CRYPTO
WALLET_COPY_LEADERBOARD_PERIOD=MONTH

WALLET_COPY_SIZE_USD=5
WALLET_COPY_SIZE_MULTIPLIER=1.0
WALLET_COPY_MAX_DELAY_SECONDS=80
WALLET_COPY_MIN_TRADE_USD=3
WALLET_COPY_CRYPTO_ONLY=false
WALLET_COPY_COOLDOWN_SECONDS=60
WALLET_COPY_MIN_WALLET_POLL_SECONDS=2.0

# Wallet rotation (auto-replace inactive tracked wallets)
WALLET_ROTATION_ENABLED=false
WALLET_ROTATION_REFRESH_INTERVAL_SECONDS=600
WALLET_ROTATION_INACTIVITY_THRESHOLD_HOURS=24
WALLET_ROTATION_MAX_REPLACEMENTS_PER_CYCLE=2
WALLET_ROTATION_MIN_TRACKED_WALLETS=1
WALLET_ROTATION_CANDIDATE_POOL_SIZE=30
WALLET_ROTATION_MIN_TRADES=20
WALLET_ROTATION_MIN_CRYPTO_PCT=70
WALLET_ROTATION_MIN_SHORTTERM_PCT=40
WALLET_ROTATION_MAX_DAYS_SINCE_LAST_TRADE=1
WALLET_ROTATION_MIN_TRADES_PER_DAY=0.5
WALLET_ROTATION_REMOVED_COOLDOWN_HOURS=24

# =============================================================================
# TELEGRAM (fill in from .env)
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
