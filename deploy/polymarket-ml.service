[Unit]
Description=Polymarket ML directional 15m paper experiment
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/polymarket-bot
EnvironmentFile=/opt/polymarket-bot/.env
EnvironmentFile=/opt/polymarket-bot/config/ml-15m-paper.env
ExecStart=/opt/polymarket-bot/venv/bin/python -m src.bot --strategy ml_directional --paper
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
