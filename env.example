# =============================================================================
# Polymarket Trading Bot - Environment Configuration
# =============================================================================
# NEVER commit this file to git!

# =============================================================================
# MODE CONFIGURATION
# =============================================================================
PAPER_TRADING=false
PAPER_BALANCE_USD=10000

# =============================================================================
# POLYMARKET CREDENTIALS (Required)
# =============================================================================
# Single-wallet mode:
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=

# Multi-wallet mode (optional):
# - Set BOT_WALLET_ID to pick which wallet profile this process uses.
# - Keep per-wallet secrets in .env only (do not share).
# Example:
# BOT_WALLET_ID=ALPHA
# POLYMARKET_PRIVATE_KEY_ALPHA=...
# POLYMARKET_PROXY_ADDRESS_ALPHA=0x...
BOT_WALLET_ID=A

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
MIN_SPREAD_CENTS=1
MAX_POSITION_USD=20000
MAX_TOTAL_EXPOSURE_USD=10000000
ORDER_SIZE_USD=5

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
DAILY_LOSS_LIMIT_USD=500
DAILY_PROFIT_TARGET_USD=2000
MIN_BALANCE_USD=5
MAX_ACTIVE_ORDERS=10000
ORDER_TIMEOUT_SECONDS=300

# =============================================================================
# BINANCE API
# =============================================================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SYMBOL=btcusdt

# =============================================================================
# KALSHI API (optional, for cross-platform arb)
# =============================================================================
KALSHI_BASE_URL=
KALSHI_TRADE_API_PATH=/trade-api/v2
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_RATE_LIMIT_PER_SECOND=5
KALSHI_ORDERBOOK_TTL_SECONDS=2
KALSHI_TRADING_ENABLED=false
KALSHI_MARKET_MAP_PATH=./data/kalshi_market_map.json
KALSHI_MIN_PROFIT_CENTS=2

# =============================================================================
# MARKET FILTERS
# =============================================================================
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95
MIN_VOLUME_USD=10000
ONLY_CRYPTO_MARKETS=false

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
SCAN_INTERVAL_SECONDS=3
MARKET_REFRESH_SECONDS=300
BALANCE_REFRESH_SECONDS=60
ENABLE_WEBSOCKET_FEED=false
LOG_LEVEL=INFO
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5
# Leave BOT_STATE_DB unset to auto-use per-wallet DB:
# - bot_state_<wallet_id>.sqlite when BOT_WALLET_ID is set
# - bot_state.sqlite otherwise
# BOT_STATE_DB=./data/bot_state.sqlite
AUTO_ALLOWANCE_REFRESH_ENABLED=true
ALLOWANCE_REFRESH_SECONDS=900
ENABLE_STRATEGY_ANALYTICS=false

# =============================================================================
# 5-MINUTE BTC MARKET SETTINGS
# =============================================================================
ENABLE_BTC_5MIN=false
BTC_MIN_MOVE_PCT=0.15
BTC_REACTION_WINDOW_SECONDS=10
BTC_MIN_CONFIDENCE=0.55
TERMINAL_CONVERGENCE_WINDOW_SECONDS=60
TERMINAL_MIN_EDGE_CENTS=3
ORDERBOOK_IMBALANCE_RATIO=2.5

# =============================================================================
# KELLY CRITERION
# =============================================================================
KELLY_FRACTION_MODE=half
KELLY_MAX_BET_FRACTION=0.05
KELLY_MIN_EDGE=0.01

# =============================================================================
# VOLATILITY REGIME (spread strategy)
# =============================================================================
VOL_WINDOW_SECONDS=300
VOL_HIGH_THRESHOLD=0.80
VOL_LOW_THRESHOLD=0.30
VOL_HIGH_SPREAD_MULT=1.5
VOL_LOW_SPREAD_MULT=0.7

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# =============================================================================
# STRATEGY SELECTION
# =============================================================================
DISABLED_STRATEGIES=spread,favorite_longshot,cross_platform_arbitrage,btc_5min,vpin,sentiment
ADAPTIVE_RISK_ENABLED=false

# =============================================================================
# VPIN (Smart Money Detection)
# =============================================================================
VPIN_THRESHOLD=0.60
VPIN_BUCKET_SECONDS=15
VPIN_BUCKET_COUNT=20
VPIN_MIN_VOLUME_USD=50
VPIN_COOLDOWN_SECONDS=120

# =============================================================================
# SENTIMENT (News-driven trading)
# =============================================================================
CRYPTOPANIC_API_KEY=
SENTIMENT_THRESHOLD=0.40
SENTIMENT_POLL_INTERVAL=60
SENTIMENT_COOLDOWN=300

# =============================================================================
# COMBINATORIAL ARBITRAGE
# =============================================================================
COMBO_MIN_EDGE_CENTS=3
COMBO_COOLDOWN=300

# =============================================================================
# WALLET COPY
# =============================================================================
# Manual wallet list (from polymarket.com profile URLs)
TRACKED_WALLETS=

# Or auto from leaderboard
WALLET_COPY_USE_LEADERBOARD=true
WALLET_COPY_LEADERBOARD_TOP_N=4
WALLET_COPY_LEADERBOARD_CATEGORY=CRYPTO
WALLET_COPY_LEADERBOARD_PERIOD=MONTH

WALLET_COPY_SIZE_USD=5
WALLET_COPY_SIZE_MULTIPLIER=1.0
WALLET_COPY_MAX_DELAY_SECONDS=80
WALLET_COPY_MIN_TRADE_USD=10
WALLET_COPY_CRYPTO_ONLY=true
WALLET_COPY_COOLDOWN_SECONDS=60