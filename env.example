# =============================================================================
# Polymarket Micro-Spread Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# =============================================================================
# POLYMARKET CREDENTIALS (Required)
# =============================================================================
# Your wallet's private key (exported from MetaMask, Binance Web3 Wallet, etc.)
# Used to sign orders - KEEP THIS SECRET!
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Your Polymarket proxy wallet address
# Find this on polymarket.com - click your profile, it's the address shown
POLYMARKET_PROXY_ADDRESS=0xYourProxyAddressHere

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Minimum spread in cents to consider a trade (2 = 2 cents)
MIN_SPREAD_CENTS=2

# Maximum position size per market in USD
MAX_POSITION_USD=100

# Maximum total portfolio exposure in USD
MAX_TOTAL_EXPOSURE_USD=500

# Order size in USD per trade
ORDER_SIZE_USD=10

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Daily loss limit - bot stops trading if reached
DAILY_LOSS_LIMIT_USD=50

# Daily profit target - optional, bot can continue or stop
DAILY_PROFIT_TARGET_USD=100

# Minimum USDC balance to maintain (bot won't trade below this)
MIN_BALANCE_USD=50

# Maximum number of active orders at once
MAX_ACTIVE_ORDERS=20

# Order timeout in seconds (cancel stale orders)
ORDER_TIMEOUT_SECONDS=300

# =============================================================================
# MARKET FILTERS
# =============================================================================
# Only trade markets with prices between these values (avoid near-resolution)
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95

# Minimum 24h volume in USD to consider a market
MIN_VOLUME_USD=10000

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
# How often to check for opportunities (seconds)
SCAN_INTERVAL_SECONDS=5

# Enable paper trading mode (no real orders)
PAPER_TRADING=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO



