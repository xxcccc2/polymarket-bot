# =============================================================================
# Polymarket Micro-Spread Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# =============================================================================
# POLYMARKET CREDENTIALS (Required)
# =============================================================================
# Your wallet's private key (exported from MetaMask, Binance Web3 Wallet, etc.)
# Used to sign orders - KEEP THIS SECRET!
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Your Polymarket proxy wallet address
# Find this on polymarket.com - click your profile, it's the address shown
POLYMARKET_PROXY_ADDRESS=0xYourProxyAddressHere

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Minimum spread in cents to consider a trade (2 = 2 cents)
MIN_SPREAD_CENTS=2

# Maximum position size per market in USD
MAX_POSITION_USD=100

# Maximum total portfolio exposure in USD
MAX_TOTAL_EXPOSURE_USD=500

# Order size in USD per trade
ORDER_SIZE_USD=10

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Daily loss limit - bot stops trading if reached
DAILY_LOSS_LIMIT_USD=50

# Daily profit target - optional, bot can continue or stop
DAILY_PROFIT_TARGET_USD=100

# Minimum USDC balance to maintain (bot won't trade below this)
MIN_BALANCE_USD=50

# Maximum number of active orders at once
MAX_ACTIVE_ORDERS=20

# Order timeout in seconds (cancel stale orders)
ORDER_TIMEOUT_SECONDS=300

# =============================================================================
# BINANCE API SETTINGS (public WS works without keys for market data)
# =============================================================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SYMBOL=btcusdt

# =============================================================================
# POLYMARKET API SETTINGS
# =============================================================================
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=

# =============================================================================
# KALSHI API SETTINGS
# =============================================================================
# https://docs.kalshi.com/getting_started/api_keys
KALSHI_BASE_URL=https://api.elections.kalshi.com
KALSHI_TRADE_API_PATH=/trade-api/v2
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_RATE_LIMIT_PER_SECOND=5
KALSHI_ORDERBOOK_TTL_SECONDS=2
KALSHI_TRADING_ENABLED=false
KALSHI_MARKET_MAP_PATH=./data/kalshi_market_map.json
KALSHI_MIN_PROFIT_CENTS=2

# =============================================================================
# MARKET FILTERS
# =============================================================================
# Only trade markets with prices between these values (avoid near-resolution)
MIN_PRICE_CENTS=5
MAX_PRICE_CENTS=95

# Minimum 24h volume in USD to consider a market
MIN_VOLUME_USD=10000

# Only trade crypto markets (set to false for political/sports/all markets)
# false = scan ALL markets (more opportunities for favorite-longshot strategy)
# true = only crypto price prediction markets
ONLY_CRYPTO_MARKETS=false

# =============================================================================
# BOT BEHAVIOR
# =============================================================================
# How often to check for opportunities (seconds)
SCAN_INTERVAL_SECONDS=5

# How often to refresh market universe (seconds)
MARKET_REFRESH_SECONDS=300

# How often to refresh account balance (seconds)
BALANCE_REFRESH_SECONDS=60

# Enable paper trading mode (no real orders)
PAPER_TRADING=true

# Paper trading balance in USD
PAPER_BALANCE_USD=1000

# Enable WebSocket feed for orderbook updates
ENABLE_WEBSOCKET_FEED=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Retry/backoff settings
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5

# SQLite database path for bot state (orders/positions/trades)
BOT_STATE_DB=./data/bot_state.sqlite

# =============================================================================
# 5-MINUTE BTC MARKET SETTINGS
# =============================================================================
ENABLE_BTC_5MIN=true
# Min BTC price move (%) on Binance to trigger cross-asset signal
BTC_MIN_MOVE_PCT=0.15
# Seconds after Binance move to trade Polymarket
BTC_REACTION_WINDOW_SECONDS=10
# Min confidence for cross-asset signal
BTC_MIN_CONFIDENCE=0.55
# Seconds before expiry for terminal convergence
TERMINAL_CONVERGENCE_WINDOW_SECONDS=60
# Min mispricing (cents) for terminal convergence
TERMINAL_MIN_EDGE_CENTS=3
# Min bid/ask volume ratio for orderbook imbalance
ORDERBOOK_IMBALANCE_RATIO=2.5

# =============================================================================
# KELLY CRITERION
# =============================================================================
# Mode: full, half, quarter
KELLY_FRACTION_MODE=half
# Max bet as fraction of bankroll
KELLY_MAX_BET_FRACTION=0.05
# Min edge to size a bet
KELLY_MIN_EDGE=0.01

# =============================================================================
# VOLATILITY REGIME (spread strategy)
# =============================================================================
VOL_WINDOW_SECONDS=300
VOL_HIGH_THRESHOLD=0.80
VOL_LOW_THRESHOLD=0.30
VOL_HIGH_SPREAD_MULT=1.5
VOL_LOW_SPREAD_MULT=0.7

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your numeric chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# =============================================================================
# STRATEGY SELECTION
# =============================================================================
# Comma-separated strategies to disable (won't load even in "all" mode)
# Default kills capital-inefficient strategies for small bankrolls
DISABLED_STRATEGIES=spread,arbitrage,favorite_longshot,cross_platform_arbitrage

# Adaptive risk management (bankroll-proportional limits, drawdown throttling)
ADAPTIVE_RISK_ENABLED=true

# =============================================================================
# VPIN (Smart Money Detection)
# =============================================================================
# VPIN threshold to trigger (0.0-1.0, higher = more selective)
VPIN_THRESHOLD=0.60
# Time bucket size in seconds
VPIN_BUCKET_SECONDS=15
# Number of buckets to keep per market
VPIN_BUCKET_COUNT=20
# Minimum USD volume per window to act
VPIN_MIN_VOLUME_USD=50
# Cooldown per market after signal (seconds)
VPIN_COOLDOWN_SECONDS=120

# =============================================================================
# SENTIMENT (News-driven trading)
# =============================================================================
# CryptoPanic API key (optional — free public feed works without it)
# Get one at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
# Minimum sentiment score to act on (0.0-1.0)
SENTIMENT_THRESHOLD=0.40
# How often to poll news (seconds)
SENTIMENT_POLL_INTERVAL=60
# Cooldown per market after signal (seconds)
SENTIMENT_COOLDOWN=300

# =============================================================================
# COMBINATORIAL ARBITRAGE
# =============================================================================
# Minimum mispricing in cents to act on (after fees)
COMBO_MIN_EDGE_CENTS=3
# Cooldown per market pair (seconds)
COMBO_COOLDOWN=300
