# =============================================================================
# Environment Configuration
# =============================================================================
# NEVER commit this file to git!

# =============================================================================
# POLYMARKET CREDENTIALS (Required)
# =============================================================================
# Single-wallet mode:
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=

# Multi-wallet mode (optional):
# - Set BOT_WALLET_ID to pick which wallet profile this process uses.
# - Keep per-wallet secrets in .env only (do not share).
# Example:
# BOT_WALLET_ID=ALPHA
# POLYMARKET_PRIVATE_KEY_ALPHA=...
# POLYMARKET_PROXY_ADDRESS_ALPHA=0x...
# SIGNATURE_TYPE_ALPHA=1
# BOT_WALLET_ID=ALPHA
# Signature type: 0=EOA, 1=POLY_PROXY(email/magic), 2=GNOSIS_SAFE
# SIGNATURE_TYPE=2

# =============================================================================
# BINANCE API
# =============================================================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SYMBOL=btcusdt
# Leave blank to use the built-in defaults:
# BINANCE_WS_COMBINED_URL=wss://stream.binance.com:9443/stream
# BINANCE_FUTURES_WS_COMBINED_URL=wss://fstream.binance.com/stream
# BINANCE_REST_URL=https://api.binance.com
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# Multi-asset feed (BTC, ETH, SOL, XRP). Single stream, one connection.
# BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt

# =============================================================================
# KALSHI API (optional, for cross-platform arb)
# =============================================================================
KALSHI_BASE_URL=
KALSHI_TRADE_API_PATH=/trade-api/v2
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_RATE_LIMIT_PER_SECOND=5
KALSHI_ORDERBOOK_TTL_SECONDS=2
KALSHI_TRADING_ENABLED=false
KALSHI_MARKET_MAP_PATH=./data/kalshi_market_map.json
KALSHI_MIN_PROFIT_CENTS=2

# =============================================================================
# POLYBACKTEST API (optional, for backtesting)
# =============================================================================
POLYBACKTEST_API_KEY=
# POLYBACKTEST_BASE_URL=https://api.polybacktest.com

# =============================================================================
# KAGGLE API
# =============================================================================
KAGGLE_API_KEY=

# =============================================================================
# TELEGRAM ALERTS
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true